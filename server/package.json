{
  "name": "bureau-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "start:signer": "node dist/signer/service.js",
    "start:all": "node dist/all.js",
    "start:prod": "node dist/util/migrate.js && node dist/all.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/index.ts",
    "dev:signer": "tsx watch src/signer/service.ts",
    "dev:all": "tsx watch src/all.ts",
    "migrate": "tsx src/util/migrate.ts",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "migrate:prod": "node dist/util/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@pump-fun/pump-sdk": "1.6.4",
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.98.0",
    "bs58": "6.0.0",
    "fastify": "5.2.1",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "tweetnacl": "1.0.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "pino-pretty": "13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}