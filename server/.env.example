# ---------------------------------------------------------------- basics
NODE_ENV=development
PORT=8080
SIGNER_PORT=8081
LOG_LEVEL=debug
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

DATABASE_URL=postgres://bureau:bureau@localhost:5432/bureau

# ---------------------------------------------------------------- Solana
# Start on devnet. Switch to mainnet-beta only after a full devnet run.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# A paid RPC (Helius, Triton, QuickNode) is required in production:
# the public endpoint rate-limits hard and will drop launches.

# Pays network fees for upkeep. Keep ~1 SOL on it. Base58 or JSON array.
PLATFORM_PAYER_SECRET=

# Seals agent wallet keys at rest. Generate with: openssl rand -base64 32
# Losing this loses every agent wallet. Back it up somewhere other than the server.
MASTER_KEY=

# Where the non-agent shares of creator fees land. Three different addresses.
PLATFORM_FEE_WALLET=
CREDITS_WALLET=
BUYBACK_WALLET=
# $BUREAU, once it exists. Leave empty until then.
BUREAU_MINT=

# Must total 10000.
SHARE_AGENT_BPS=8500
SHARE_PLATFORM_BPS=500
SHARE_CREDITS_BPS=500
SHARE_BUYBACK_BPS=500

# ---------------------------------------------------------------- models
OPENROUTER_API_KEY=
# Optional. Without these the research tools report themselves unavailable
# instead of guessing.
SEARCH_PROVIDER=none
SEARCH_API_KEY=
X_BEARER_TOKEN=

# ---------------------------------------------------------------- signer
# Generate with: openssl rand -hex 32
SIGNER_TOKEN=
SIGNER_URL=http://localhost:8081

# ---------------------------------------------------------------- switches
# All three start off. Turn them on one at a time, on devnet first.
LAUNCH_ENABLED=false
MONEY_ENABLED=false
SOCIAL_ENABLED=false

# ---------------------------------------------------------------- limits
WAKE_THRESHOLD_USD=20
MCAP_FLOOR_USD=6000
WAKE_INTERVAL_MIN=12
MAX_WAKE_SECONDS=120
MAX_TOOL_CALLS_PER_WAKE=12

DEFAULT_MAX_PER_MOVE_LAMPORTS=200000000
DEFAULT_MAX_PER_HOUR_LAMPORTS=500000000
DEFAULT_MAX_PER_DAY_LAMPORTS=2000000000
DEFAULT_RESERVE_FLOOR_LAMPORTS=50000000
DEFAULT_MAX_PRICE_IMPACT_BPS=300
